# SecureOps deploy environment variables
# Copy this file to .env and fill in your values before running make.
# Never commit .env — it contains credentials.

# ─── Wazuh ─────────────────────────────────────────────────────────────────────
# Demo mode uses the password built into the Wazuh demo image (admin).
# To harden, update the bcrypt hash in internal_users.yml inside the container.

WAZUH_INDEXER_PASSWORD=admin
WAZUH_API_PASSWORD=SecureOps_API!23
WAZUH_DASHBOARD_PASSWORD=SecureOps_D4sh!

# ─── DefectDojo ────────────────────────────────────────────────────────────────
DD_ADMIN_PASSWORD=SecureOps_DD!23
DD_ADMIN_MAIL=admin@example.com
DD_DB_PASSWORD=defectdojo_db_pass

# Must be at least 32 characters — used to sign sessions.
DD_SECRET_KEY=change-me-before-production-use-32chars

# Must be exactly 16 characters — used for AES-256 encryption of credentials.
DD_CREDENTIAL_AES_256_KEY=changeme16chars!
